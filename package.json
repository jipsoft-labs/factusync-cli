{
  "name": "@jipsoft/factusync-cli",
  "version": "0.1.0",
  "description": "FactuSync command line for AI agents (Pi) and shell scripts: Ecuadorian SRI e-invoicing through the FactuSync MCP endpoint",
  "license": "MIT",
  "keywords": [
    "factusync",
    "sri",
    "ecuador",
    "facturacion-electronica",
    "mcp",
    "cli"
  ],
  "homepage": "https://jipsoft.com/factusync/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jipsoft-labs/jipsoft-global.git",
    "directory": "packages/factusync-cli"
  },
  "bugs": {
    "url": "https://github.com/jipsoft-labs/jipsoft-global/issues"
  },
  "type": "module",
  "bin": {
    "factusync": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json && chmod +x dist/cli.js",
    "test": "pnpm run build && pnpm exec vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.8"
  }
}
